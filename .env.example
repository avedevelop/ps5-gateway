# Copy to .env (scripts/setup.mjs does this for you). Never commit .env.

# This PC's LAN address. Leave empty to auto-detect. Give the PC a fixed IP in your router.
PC_LAN_IP=
# The PS5's LAN address (PS5: Settings > Network > View Connection Status).
PS5_IP=

# Optional. DNS servers used for everything except the PS5's Twitch broadcast address (1 to 4 IPv4, space separated).
# Default: 1.1.1.1 8.8.8.8
UPSTREAM_DNS=
# Optional, macOS. Set to 0 to let the Mac sleep during a broadcast (by default it stays awake).
KEEP_AWAKE=
# Optional. How long (seconds, 0 to 3600) the gateway remembers DNS answers for other names. Default: 30
DNS_CACHE_TTL=
# Optional. Detail of the RTMP server's log: error, warn, info or debug. Default: debug
MTX_LOG_LEVEL=
