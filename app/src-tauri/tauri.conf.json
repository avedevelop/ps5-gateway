{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PS5 Gateway",
  "version": "1.2.0",
  "identifier": "dev.ps5gateway.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PS5 Gateway",
        "width": 960,
        "height": 636,
        "resizable": false,
        "maximizable": false,
        "backgroundColor": "#0D1117",
        "visible": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}